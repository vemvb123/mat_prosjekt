# Lokal backend-konfig.
# Kopier til backend/.env.local og bytt passord hvis du vil.

# Bruk lokal SQL Server-container i stedet for Databricks.
GOLD_QUERY_BACKEND=sqlserver
LOCAL_SQL_HOST=localhost
LOCAL_SQL_PORT=1433
LOCAL_SQL_DATABASE=mat_prosjekt
LOCAL_SQL_USER=sa
LOCAL_SQL_PASSWORD=Your_strong_password123
LOCAL_SQL_GOLD_TABLE=dbo.product_nutritiens_gold
LOCAL_SQL_ENCRYPT=false
LOCAL_SQL_TRUST_CERT=true

# Bruk lokal Redis-container for samme cacheflyt som i Azure.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local_redis_password
REDIS_TLS=false

# Lokal HTTP-server.
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGIN=http://127.0.0.1:5173
